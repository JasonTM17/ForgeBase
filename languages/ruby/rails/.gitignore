# See https://help.github.com/articles/about-gitignore/ for more ignore rules.

# Ignore bundler config and installed gems.
/.bundle
/vendor/bundle/

# Ignore all environment files (except examples).
/.env*
!/.env.example

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore uploaded files in development.
/storage/*
!/storage/.keep

# Ignore master key for decrypting credentials.
/config/master.key

# Ignore precompiled assets.
/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore node_modules (importmap).
/node_modules

# Ignore Spring files.
/spring/*.pid
