# ForgeBase Django starter configuration
# Copy to .env (or export directly). Settings validate at boot.

# REQUIRED in production; dev/testing fall back to an insecure dev key.
DJANGO_SECRET_KEY=

FORGE_APP_ENV=development
FORGE_LOG_LEVEL=INFO

# Comma-separated hosts; required (non-empty) in production.
FORGE_ALLOWED_HOSTS=localhost,127.0.0.1
